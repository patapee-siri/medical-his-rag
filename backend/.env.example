# ===== API =====
API_HOST=0.0.0.0
API_PORT=8000
API_KEY=sk-medical-his-dev-12345
APP_ENV=development

# CORS (comma-separated origins the frontend runs on)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ===== Database =====
DATABASE_URL=sqlite:///./medical_his.db

# ===== Qdrant Vector DB =====
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=qdrant-dev-key
QDRANT_COLLECTION=medical_documents

# ===== HuggingFace Inference API =====
# Get a free token at https://huggingface.co/settings/tokens
HF_API_TOKEN=hf_your_token_here
HF_MODEL_ID=google/medgemma-1.5-7b

# ===== Logging =====
LOG_LEVEL=INFO
