# ===== API =====
API_HOST=0.0.0.0
API_PORT=8000
API_KEY=sk-medical-his-dev-12345
APP_ENV=development

# CORS (comma-separated origins the frontend runs on)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ===== Database =====
DATABASE_URL=sqlite:///./medical_his.db

# ===== Qdrant Vector DB =====
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=qdrant-dev-key
QDRANT_COLLECTION=medical_documents

# ===== HuggingFace Inference API =====
# Get a free token at https://huggingface.co/settings/tokens (Inference scope).
# Note: MedGemma is not on HF's free serverless providers. Reliable defaults:
#   meta-llama/Llama-3.1-8B-Instruct  or  Qwen/Qwen2.5-7B-Instruct
HF_API_TOKEN=hf_your_token_here
HF_MODEL_ID=meta-llama/Llama-3.1-8B-Instruct

# ===== Live multi-source RAG (hybrid) =====
# When local results are weak, fetch fresh CREDIBLE literature, cache it in
# Qdrant, and re-search. Only peer-reviewed / authoritative sources are used —
# preprints are excluded in code (hard rule).
ENABLE_LIVE_RETRIEVAL=true
LIVE_PER_SOURCE_LIMIT=5
LIVE_MIN_LOCAL_HITS=3
LIVE_SCORE_THRESHOLD=0.66
LIVE_TIMEOUT_SECONDS=8
SOURCE_PUBMED=true
SOURCE_EUROPEPMC=true
SOURCE_CLINICALTRIALS=true
# Optional NCBI key raises the PubMed rate limit (https://www.ncbi.nlm.nih.gov/account/)
NCBI_API_KEY=

# ===== Logging =====
LOG_LEVEL=INFO
